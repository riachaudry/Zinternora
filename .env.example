# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# ---------- App ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Karachi

# ---------- Storage buckets (created by supabase/storage.sql) ----------
NEXT_PUBLIC_BUCKET_AVATARS=avatars
NEXT_PUBLIC_BUCKET_PAYMENTS=payment-proofs
NEXT_PUBLIC_BUCKET_SUBMISSIONS=submissions
NEXT_PUBLIC_BUCKET_DOCUMENTS=documents

# ---------- Email (Resend or any SMTP provider) ----------
EMAIL_PROVIDER=resend          # resend | console
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Zinternora <no-reply@your-domain.com>"

# ---------- Security ----------
INVITE_TOKEN_SECRET=change-this-to-a-long-random-string
INVITE_TOKEN_TTL_HOURS=72
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
